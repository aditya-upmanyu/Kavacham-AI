# =====================================================================
# KAVACHAM AI — Environment Configuration Template
# =====================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# =====================================================================

# Flask Secret Key (generate a strong random string for production)
FLASK_SECRET_KEY=your-strong-secret-key-here

# Set to 1 only for local HTTP OAuth testing (remove in production)
OAUTHLIB_INSECURE_TRANSPORT=1

# Maximum emails to fetch and classify per Gmail inbox scan
MAX_EMAILS_FETCH=20

# Gemini API Key — KEEP THIS SERVER-SIDE ONLY
# Get your key from: https://makersuite.google.com/app/apikey
# NEVER put this key in HTML, JavaScript, or frontend code.
GEMINI_API_KEY=your-gemini-api-key-here

# VirusTotal API Key — OPTIONAL, used by the Unified Threat Analysis Engine
# (backend-only threat intelligence for URLs and attachment hashes via
# intel/virustotal_service.py). When unset, Kavacham uses only its local
# detection engines and reports "Threat intelligence unavailable".
# Get your key from: https://www.virustotal.com/ (free tier available)
# NEVER put this key in HTML, JavaScript, or frontend code.
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
