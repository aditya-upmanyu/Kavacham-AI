# .env.example
# Copy this file to .env and configure values if needed

# Flask Secret Key for session encryption
FLASK_SECRET_KEY=your_generated_random_secret_key_here_or_leave_blank_for_auto_dev_key

# Set to 1 only for local HTTP OAuth testing (never for HTTPS production)
OAUTHLIB_INSECURE_TRANSPORT=1

# Maximum emails to fetch and classify per scan
MAX_EMAILS_FETCH=20
